#define FAMILY_STATS_LEN (48)

forward Families_PredicateInFamily(playerid);

/**
 *      ______                                   __      __
 *     /      \                                 |  \    |  |
 *    |  $$$$$$\ __    __  _______    _______  _| $$_    \$$  ______   _______    _______
 *    | $$_  \$$|  \  |  \|       \  /       \|   $$ \  |  \ /      \ |       \  /       |
 *    | $$ \    | $$  | $$| $$$$$$$\|  $$$$$$$ \$$$$$$  | $$|  $$$$$$\| $$$$$$$\|  $$$$$$$
 *    | $$$$    | $$  | $$| $$  | $$| $$        | $$ __ | $$| $$  | $$| $$  | $$ \$$    |
 *    | $$      | $$__/ $$| $$  | $$| $$_____   | $$|  \| $$| $$__/ $$| $$  | $$ _\$$$$$$|
 *    | $$       \$$    $$| $$  | $$ \$$     \   \$$  $$| $$ \$$    $$| $$  | $$|       $$
 *     \$$        \$$$$$$  \$$   \$$  \$$$$$$$    \$$$$  \$$  \$$$$$$  \$$   \$$ \$$$$$$$
 *
 */
static Families_FillStats(targetid)
{
    new text[FAMILY_STATS_LEN];

    if (!Families_IsIn(targetid))
    {
        Stats_SetText("Family",FAMILY_DEFAULT_TEXT);
        return;
    }

    Families_GetName(Families_GetMember(targetid),text);
    Stats_SetText("Family",text);

    if (Factions_GetTeam(targetid) != TEAM_COR)
    {
        Factions_GetMafiaTitle(Families_GetRank(targetid),text);
        Stats_SetText("Rank",text);
    }
}

static Families_ChooseSpawn(playerid)
{
    if (!Families_IsIn(playerid) || !Families_HasSpawn(Families_GetMember(playerid)))
    {
        return;
    }

    new Float:x, Float:y, Float:z, Float:angle, interior;
    Families_GetSpawn(Families_GetMember(playerid),x,y,z,angle,interior);
    Spawn_SetPoint(playerid,x,y,z,angle,interior,SPAWN_PRIORITY_FAMILY);
}

/**
 *                        __  __  __                            __
 *                       |  \|  \|  \                          |  |
 *      _______  ______  | $$| $$| $$____    ______    _______ | $$   __   _______
 *     /       \|      \ | $$| $$| $$    \  |      \  /       \| $$  /  \ /       |
 *    |  $$$$$$$ \$$$$$$\| $$| $$| $$$$$$$\  \$$$$$$\|  $$$$$$$| $$_/  $$|  $$$$$$$
 *    | $$      /      $$| $$| $$| $$  | $$ /      $$| $$      | $$   $$  \$$    |
 *    | $$_____|  $$$$$$$| $$| $$| $$__/ $$|  $$$$$$$| $$_____ | $$$$$$\  _\$$$$$$|
 *     \$$     \\$$    $$| $$| $$| $$    $$ \$$    $$ \$$     \| $$  \$$\|       $$
 *      \$$$$$$$ \$$$$$$$ \$$ \$$ \$$$$$$$   \$$$$$$$  \$$$$$$$ \$$   \$$ \$$$$$$$
 *
 */
public Families_PredicateInFamily(playerid)
{
    return Families_IsIn(playerid);
}

/**
 *     __                            __
 *    |  \                          |  |
 *    | $$____    ______    ______  | $$   __   _______
 *    | $$    \  /      \  /      \ | $$  /  \ /       |
 *    | $$$$$$$\|  $$$$$$\|  $$$$$$\| $$_/  $$|  $$$$$$$
 *    | $$  | $$| $$  | $$| $$  | $$| $$   $$  \$$    |
 *    | $$  | $$| $$__/ $$| $$__/ $$| $$$$$$\  _\$$$$$$|
 *    | $$  | $$ \$$    $$ \$$    $$| $$  \$$\|       $$
 *     \$$   \$$  \$$$$$$   \$$$$$$  \$$   \$$ \$$$$$$$
 *
 */
#include <pp-hooks>

hook Stats_OnBuild(playerid,targetid)
{
    #pragma unused playerid

    Families_FillStats(targetid);
}

hook Spawn_OnChoose(playerid)
{
    Families_ChooseSpawn(playerid);
}

hook OnPlayerSpawn(playerid)
{
    if (IsPlayerNPC(playerid) || !Player_IsReady(playerid))
    {
        return;
    }

    Turfs_ShowFor(playerid);
}
