#include <pp-hooks>

hook OnGameModeInit()
{
    Offer_RegisterAccept("taxi","Transport_AcceptTaxi");
    Offer_RegisterCancel("taxi","Transport_CancelTaxi");
    Service_Register("taxi","Transport_ServiceTaxi");
    Offer_RegisterAccept("bus","Transport_AcceptBus");
    Offer_RegisterCancel("bus","Transport_CancelBus");
    Service_Register("bus","Transport_ServiceBus");
}
