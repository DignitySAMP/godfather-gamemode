#include <pp-hooks>

hook OnGameModeInit()
{
    Player_RegisterLoader(PHONE_LOADER);
    Chat_RegisterInterceptor("Phone_ChatCall",CHAT_SLOT_PHONE);
    Help_RegisterReader(HELP_FIELD_PHONE,"Phone_HelpNumber");
}

hook OnMigrationRun()
{
    Migration_Add("phone-1-player-phone", "CREATE TABLE IF NOT EXISTS player_phone (account_id INT UNSIGNED NOT NULL, number INT NOT NULL DEFAULT 0, phonebook INT NOT NULL DEFAULT 0, PRIMARY KEY (account_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
}
