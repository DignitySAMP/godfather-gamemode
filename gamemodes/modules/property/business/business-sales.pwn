forward Business_UpgradeStock(playerid);

/**
 *      ______                                   __      __
 *     /      \                                 |  \    |  |
 *    |  $$$$$$\ __    __  _______    _______  _| $$_    \$$  ______   _______    _______
 *    | $$_  \$$|  \  |  \|       \  /       \|   $$ \  |  \ /      \ |       \  /       |
 *    | $$ \    | $$  | $$| $$$$$$$\|  $$$$$$$ \$$$$$$  | $$|  $$$$$$\| $$$$$$$\|  $$$$$$$
 *    | $$$$    | $$  | $$| $$  | $$| $$        | $$ __ | $$| $$  | $$| $$  | $$ \$$    |
 *    | $$      | $$__/ $$| $$  | $$| $$_____   | $$|  \| $$| $$__/ $$| $$  | $$ _\$$$$$$|
 *    | $$       \$$    $$| $$  | $$ \$$     \   \$$  $$| $$ \$$    $$| $$  | $$|       $$
 *     \$$        \$$$$$$  \$$   \$$  \$$$$$$$    \$$$$  \$$  \$$$$$$  \$$   \$$ \$$$$$$$
 *
 */
stock Business_RegisterLinks()
{
    Houses_SetPredicate(HOUSE_PREDICATE_UPGRADE_STOCK,"Business_UpgradeStock");
}

static Business_RecordShopSale(shop,amount)
{
    if (shop < 0 || shop >= BUSINESS_SPECIAL_COUNT)
    {
        return;
    }

    new key = BUSINESS_SPECIAL_BASE + shop;
    Business_SetProducts(key,Vehicles_GetShopStock(shop));
    Business_Earn(key,amount);
}

static Business_RecordUpgrade(price)
{
    new key = BUSINESS_SPECIAL_BASE + SBIZ_HOUSE_UPGRADE;
    Business_UseProduct(key);
    Business_Earn(key,price);
}

/**
 *                        __  __  __                            __
 *                       |  \|  \|  \                          |  |
 *      _______  ______  | $$| $$| $$____    ______    _______ | $$   __   _______
 *     /       \|      \ | $$| $$| $$    \  |      \  /       \| $$  /  \ /       |
 *    |  $$$$$$$ \$$$$$$\| $$| $$| $$$$$$$\  \$$$$$$\|  $$$$$$$| $$_/  $$|  $$$$$$$
 *    | $$      /      $$| $$| $$| $$  | $$ /      $$| $$      | $$   $$  \$$    |
 *    | $$_____|  $$$$$$$| $$| $$| $$__/ $$|  $$$$$$$| $$_____ | $$$$$$\  _\$$$$$$|
 *     \$$     \\$$    $$| $$| $$| $$    $$ \$$    $$ \$$     \| $$  \$$\|       $$
 *      \$$$$$$$ \$$$$$$$ \$$ \$$ \$$$$$$$   \$$$$$$$  \$$$$$$$ \$$   \$$ \$$$$$$$
 *
 */
public Business_UpgradeStock(playerid)
{
    return Business_GetProducts(BUSINESS_SPECIAL_BASE + SBIZ_HOUSE_UPGRADE) != 0 ? 1 : 0;
}

/**
 *     __                            __
 *    |  \                          |  |
 *    | $$____    ______    ______  | $$   __   _______
 *    | $$    \  /      \  /      \ | $$  /  \ /       |
 *    | $$$$$$$\|  $$$$$$\|  $$$$$$\| $$_/  $$|  $$$$$$$
 *    | $$  | $$| $$  | $$| $$  | $$| $$   $$  \$$    |
 *    | $$  | $$| $$__/ $$| $$__/ $$| $$$$$$\  _\$$$$$$|
 *    | $$  | $$ \$$    $$ \$$    $$| $$  \$$\|       $$
 *     \$$   \$$  \$$$$$$   \$$$$$$  \$$   \$$ \$$$$$$$
 *
 */
#include <pp-hooks>

hook Vehicles_OnSale(playerid,shop,amount,products)
{
    Business_RecordShopSale(shop,amount);
}

hook Houses_OnUpgradeBought(playerid,house,item,price)
{
    Business_RecordUpgrade(price);
}

hook Payday_OnCompute(playerid)
{
    if (Business_GetOwnedKey(playerid) != BUSINESS_NO_KEY)
    {
        Payday_SetUtilityHolder(playerid,true);
    }
}

hook Payday_OnBillPaid(playerid,amount)
{
    Business_AddTill(BUSINESS_SPECIAL_BASE + SBIZ_ELECTRICITY,amount);
}
