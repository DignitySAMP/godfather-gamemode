#include <pp-hooks>

hook OnGameModeInit()
{
    for (new i = 0;i < SPAWN_PEDS_COUNT;i++)
    {
        AddPlayerClass(Spawn_GetPedModel(i),SPAWN_CLASS_X,SPAWN_CLASS_Y,SPAWN_CLASS_Z,SPAWN_CLASS_ANGLE,WEAPON:0,0,WEAPON:0,0,WEAPON:0,0);
    }
}
