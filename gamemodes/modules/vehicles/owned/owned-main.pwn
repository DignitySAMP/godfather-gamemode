#include <pp-hooks>

hook OnGameModeInit()
{
    Vehicles_ResetDrivers();
    Command_SetDenial("resetupgrades", E_COMMAND_DENIAL_LOGIN, COLOR_GRAD1, "   You are not Logged in !");
    Timer_Start(Vehicles_CarCheckTimer, VEHICLE_CARCHECK_MS);
}
