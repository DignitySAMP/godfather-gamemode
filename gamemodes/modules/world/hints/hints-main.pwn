#include <pp-hooks>

hook OnGameModeInit()
{
    Hints_RegisterBuiltin();
}

hook Tick_OnPlayerSecond(playerid)
{
    if (IsPlayerNPC(playerid) || !Player_IsReady(playerid))
    {
        return;
    }

    if (Hints_ShowProperty(playerid))
    {
        return;
    }

    Hints_ShowFixed(playerid);
}
