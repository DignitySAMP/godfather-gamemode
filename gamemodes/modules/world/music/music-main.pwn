#include <pp-hooks>

hook OnGameModeInit()
{
    Player_RegisterLoader(MUSIC_LOADER);
}

hook OnMigrationRun()
{
    Migration_Add("music-1-players", "CREATE TABLE IF NOT EXISTS player_music (account_id INT UNSIGNED NOT NULL, cd_player TINYINT NOT NULL DEFAULT 0, PRIMARY KEY (account_id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci");
}
