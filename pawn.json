  "dependencies": [
    "openmultiplayer/omp-stdlib#17c1b0191195cb0b59a820135fbca622c84129dd",
    "pawn-lang/samp-stdlib@open.mp",
    "pawn-lang/pawn-stdlib@open.mp",
    "IS4Code/PawnPlus:v1.5.3",
    "AGraber/pawn-plus-mysql:1.0.3",
    "samp-incognito/samp-streamer-plugin:v2.9.6",
    "Y-Less/sscanf:v2.13.8",
    "oscar-broman/strlib#d48c74a65f03131381404fdc8e64873384e4c9b8",
