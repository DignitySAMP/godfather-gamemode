    {
      "name": "linux",
      "args": [
        "-Z-",
        "-;+",
        "-(+",
        "-d3"
      ],
      "includes": [
        "legacy",
        "gamemodes"
      ],
      "compiler": {
        "site": "github.com",
        "user": "openmultiplayer",
        "repo": "compiler",
        "version": "3.10.11"
      }
    }
  ]
}
